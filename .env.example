# Augment — OAuth client credentials (Google Cloud "Desktop app" OAuth client).
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
#
# How to obtain these: see the "Google Cloud OAuth setup" section of README.md.
# These are read by the Rust backend at runtime (via dotenvy) to perform the
# OAuth token exchange. They are never written to disk by the app and never
# shipped in the bundle.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
